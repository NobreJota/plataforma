<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contab · Login</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .card {
      background: #fff; border-radius: 12px;
      padding: 40px 36px; width: 100%; max-width: 380px;
      box-shadow: 0 20px 60px rgba(0,0,0,.3);
    }
    .titulo {
      text-align: center; margin-bottom: 28px;
    }
    .titulo h1 {
      font-size: 1.5rem; color: #1e3a5f; margin-bottom: 4px;
    }
    .titulo p {
      font-size: 0.85rem; color: #718096;
    }
    label {
      display: block; margin-bottom: 14px;
      font-size: 0.85rem; color: #4a5568;
    }
    label span {
      display: block; margin-bottom: 4px; font-weight: 500;
    }
    input {
      width: 100%; padding: 10px 12px;
      border: 1px solid #cbd5e0; border-radius: 6px;
      font-size: 0.95rem; font-family: inherit;
    }
    input:focus {
      outline: 2px solid #2c5282; border-color: #2c5282;
    }
    .btn {
      width: 100%; padding: 12px;
      background: #2c5282; color: #fff;
      border: 0; border-radius: 6px;
      font-size: 0.95rem; font-weight: 600; cursor: pointer;
      font-family: inherit;
      margin-top: 8px;
    }
    .btn:hover { background: #1e3a5f; }
    .erro {
      background: #fed7d7; color: #822727;
      padding: 10px 12px; border-radius: 6px;
      font-size: 0.85rem; margin-bottom: 16px;
      border-left: 3px solid #c53030;
    }
    .rodape {
      text-align: center; margin-top: 20px;
      font-size: 0.75rem; color: #a0aec0;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="titulo">
      <h1>📊 Área Contábil</h1>
      <p>Acesse com seu email e senha</p>
    </div>

    {{#if erro}}
      <div class="erro">{{erro}}</div>
    {{/if}}

    <form action="/usuariocontab/login" method="POST">
      <label>
        <span>Email</span>
        <input type="email" name="email" value="{{email}}" autocomplete="username" required {{#unless email}}autofocus{{/unless}}>
      </label>
      <label>
        <span>Senha</span>
        <input type="password" name="senha" autocomplete="current-password" required {{#if email}}autofocus{{/if}}>
      </label>
      <button type="submit" class="btn">Entrar</button>
    </form>

    <div class="rodape">Rotaes · Plataforma Contábil</div>
  </div>
</body>
</html>
