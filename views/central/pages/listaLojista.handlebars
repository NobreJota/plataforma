        font-size: .9rem;
        font-weight: 500;
        color: #1f2937;
        background-color: #fff;
        border: 1px solid #9aa3ad;
      }
      #barraColunas .btn { font-weight: 600; }
      #barraColunas .contador {
        position: absolute;
        right: 1.5vw;
        color: #6b7280;
        font-size: .85rem;
      }

</style>
