<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rotaes : Admin : Estrutura do plano</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background:#eef1f5; color:#1f2937; }
    .topo { background:#03306b; color:#fff; padding:14px 24px; }
    .topo h1 { font-size:1.35rem; font-weight:700; margin:0; }
    .topo small { color:#c7d6ee; }
    .painel { max-width:1100px; margin:20px auto; }
    .card-grupo { margin-bottom:16px; }
    .card-grupo .card-header {
      background:#e3e9f2; font-weight:700; color:#111827;
      display:flex; align-items:center; justify-content:space-between;
    }
    .sub { display:flex; align-items:center; gap:10px; padding:8px 12px; border-bottom:1px solid #eef1f5; }
    .sub:last-child { border-bottom:none; }
    .sub .codigo { font-family:monospace; font-weight:600; color:#03306b; min-width:56px; }
    .sub .nome { flex:1; }
    .sub .uso { color:#6b7280; font-size:.82rem; }
    .sub.suspenso { background:#f5f5f5; color:#9aa3ad; }
    .sub.suspenso .codigo { color:#9aa3ad; }
    .etiqueta { font-size:.72rem; background:#d1d5db; color:#374151; border-radius:4px; padding:1px 6px; }
    .aviso { font-size:.85rem; color:#6b7280; }
    #barraEmpresa { background:#fff; border-bottom:1px solid #cfd4da; padding:12px 24px; }
    /* Modais: o corpo rola por dentro, cabeçalho e botões ficam sempre visíveis */
    .modal-dialog { max-height: calc(100vh - 40px); margin-top: 20px; }
    .modal-content { max-height: calc(100vh - 40px); display: flex; flex-direction: column; }
    .modal-body { overflow-y: auto; }
  </style>
</head>
<body>

<div class="topo d-flex align-items-center justify-content-between flex-wrap gap-2">
  <div>
    <h1>Estrutura do plano de contas</h1>
    <small>Os subgrupos são criados aqui, por empresa. Cada empresa monta os títulos e subtítulos dentro deles.</small>
  </div>
  <a href="/central/menu" class="btn btn-light btn-sm">&larr; Voltar ao menu</a>
</div>

<div id="barraEmpresa" class="d-flex align-items-center gap-3 flex-wrap">
  <label for="selEmpresa" class="fw-semibold mb-0">Empresa:</label>
  <select id="selEmpresa" class="form-select" style="max-width:360px"></select>
  <div class="form-check ms-2">
    <input class="form-check-input" type="checkbox" id="chkSuspensos">
    <label class="form-check-label" for="chkSuspensos">mostrar suspensos</label>
  </div>
  <a href="/central/plano/depara" class="btn btn-success btn-sm ms-auto">De/para do plano antigo</a>
  <button id="btnImportar" class="btn btn-primary btn-sm" type="button">Importar plano</button>
  <button id="btnClonar" class="btn btn-outline-dark btn-sm" type="button">Clonar estrutura de outra empresa</button>
</div>

<div class="painel">
  <div id="conteudo"><p class="aviso">Escolha uma empresa.</p></div>
</div>

<!-- Modal: novo/renomear subgrupo -->
<div class="modal" tabindex="-1" id="modalSub">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="modalSubTitulo">Novo subgrupo</h5></div>
      <div class="modal-body">
        <p class="aviso" id="modalSubContexto"></p>
        <label class="form-label">Nome</label>
        <input type="text" id="subNome" class="form-control" maxlength="60">
        <label class="form-label mt-3">Descrição (opcional)</label>
        <input type="text" id="subDescricao" class="form-control">
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" onclick="fecharModal('modalSub')">Cancelar</button>
        <button class="btn btn-primary" type="button" id="btnSalvarSub">Salvar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: importar plano -->
<div class="modal" tabindex="-1" id="modalImportar">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Importar plano de contas</h5></div>
      <div class="modal-body">
        <p class="aviso">
          Uma conta por linha, com código e nome. A profundidade do código diz o nível:
          <code>1.01</code> subgrupo, <code>1.01.001</code> título, <code>1.01.001.0001</code> subtítulo.
          Aceita .csv (ponto e vírgula) e .xlsx.
        </p>
        <div class="row g-3">
          <div class="col-md-7">
            <label class="form-label">Arquivo</label>
            <input type="file" id="arqPlano" class="form-control" accept=".csv,.xlsx,.xls">
          </div>
          <div class="col-md-5">
            <label class="form-label">Dígitos do subtítulo</label>
            <select id="selDigitos" class="form-select">
              <option value="4" selected>4 — até 9.999 por título</option>
              <option value="3">3 — até 999 (como o sistema antigo)</option>
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label">Data do último documento no sistema antigo</label>
            <input type="date" id="dataReferencia" class="form-control">
            <span class="aviso">vem do arquivo, se ele trouxer a linha #referencia</span>
          </div>
          <div class="col-md-7 d-flex align-items-end gap-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="chkEnsaio" checked>
              <label class="form-check-label" for="chkEnsaio">é um ensaio (não é a virada)</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="chkNomes">
              <label class="form-check-label" for="chkNomes">atualizar nomes que mudaram</label>
            </div>
          </div>
        </div>
        <div id="historicoImport" class="aviso mt-3"></div>
        <div id="previaImport" class="mt-3"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" onclick="fecharModal('modalImportar')">Fechar</button>
        <button class="btn btn-outline-primary" type="button" id="btnConferir">Conferir</button>
        <button class="btn btn-primary" type="button" id="btnAplicarImport" disabled>Importar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: clonar -->
<div class="modal" tabindex="-1" id="modalClonar">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Clonar estrutura</h5></div>
      <div class="modal-body">
        <p class="aviso">Copia os subgrupos da empresa escolhida para a empresa selecionada acima.
          Subgrupos que já existirem lá são ignorados. Títulos e subtítulos não são copiados.</p>
        <label class="form-label">Copiar de:</label>
        <select id="selOrigem" class="form-select"></select>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" onclick="fecharModal('modalClonar')">Cancelar</button>
        <button class="btn btn-primary" type="button" id="btnConfirmarClonar">Clonar</button>
      </div>
    </div>
  </div>
</div>

<script>
const API = '/central/plano/api';
let empresas = [];
let modo = { acao: null, grupoId: null, subId: null };

function abrirModal(id) { document.getElementById(id).style.display = 'block'; document.getElementById(id).classList.add('show'); }
function fecharModal(id) { document.getElementById(id).style.display = 'none'; document.getElementById(id).classList.remove('show'); }

async function api(metodo, caminho, corpo) {
  const resp = await fetch(API + caminho, {
    method: metodo,
    headers: { 'Content-Type': 'application/json' },
    body: corpo ? JSON.stringify(corpo) : undefined
  });
  const dado = await resp.json().catch(() => ({}));
  if (!resp.ok) throw new Error(dado.erro || 'Erro na requisição.');
  return dado;
}

function empresaAtual() { return document.getElementById('selEmpresa').value; }

async function carregarEmpresas() {
  empresas = await api('GET', '/empresas');
  const opcoes = empresas.map(e => `<option value="${e._id}">${e.razao || e.marca || '(sem nome)'}</option>`).join('');
  document.getElementById('selEmpresa').innerHTML = '<option value="">Escolha...</option>' + opcoes;
  document.getElementById('selOrigem').innerHTML = opcoes;
}

async function carregarEstrutura() {
  const id = empresaAtual();
  const alvo = document.getElementById('conteudo');
  if (!id) { alvo.innerHTML = '<p class="aviso">Escolha uma empresa.</p>'; return; }

  const inativos = document.getElementById('chkSuspensos').checked;
  const grupos = await api('GET', `/estrutura/${id}?incluirInativos=${inativos}`);

  alvo.innerHTML = grupos.map(g => `
    <div class="card card-grupo">
      <div class="card-header">
        <span>${g.codigo} — ${g.nome}</span>
        <button class="btn btn-sm btn-primary" onclick="novoSub('${g._id}','${g.codigo} — ${g.nome}')">+ subgrupo</button>
      </div>
      <div class="card-body p-0">
        ${g.subgrupos.length ? g.subgrupos.map(s => `
          <div class="sub ${s.ativo === false ? 'suspenso' : ''}">
            <span class="codigo">${s.codigo}</span>
            <span class="nome">${s.nome} ${s.ativo === false ? '<span class="etiqueta">suspenso</span>' : ''}</span>
            <span class="uso">${s.titulos} título(s)</span>
            ${s.ativo === false
              ? `<button class="btn btn-sm btn-outline-success" onclick="reativar('${s._id}')">Reativar</button>`
              : `<button class="btn btn-sm btn-outline-secondary" onclick="renomear('${s._id}','${s.nome.replace(/'/g, "\\'")}','${s.codigo}')">Renomear</button>
                 <button class="btn btn-sm btn-outline-danger" onclick="suspender('${s._id}','${s.codigo}')">Suspender</button>`}
          </div>`).join('')
          : '<p class="aviso m-3">Nenhum subgrupo neste grupo.</p>'}
      </div>
    </div>`).join('');
}

function novoSub(grupoId, rotulo) {
  modo = { acao: 'novo', grupoId, subId: null };
  document.getElementById('modalSubTitulo').textContent = 'Novo subgrupo';
  document.getElementById('modalSubContexto').textContent = 'Em ' + rotulo + '. O código é gerado na sequência da empresa.';
  document.getElementById('subNome').value = '';
  document.getElementById('subDescricao').value = '';
  abrirModal('modalSub');
  setTimeout(() => document.getElementById('subNome').focus(), 50);
}

function renomear(subId, nome, codigo) {
  modo = { acao: 'renomear', grupoId: null, subId };
  document.getElementById('modalSubTitulo').textContent = 'Renomear subgrupo';
  document.getElementById('modalSubContexto').textContent = 'Código ' + codigo + ' (o código não muda).';
  document.getElementById('subNome').value = nome;
  document.getElementById('subDescricao').value = '';
  abrirModal('modalSub');
}

document.getElementById('btnSalvarSub').addEventListener('click', async () => {
  const nome = document.getElementById('subNome').value.trim();
  const descricao = document.getElementById('subDescricao').value.trim();
  if (!nome) { alert('Informe o nome.'); return; }
  try {
    if (modo.acao === 'novo') {
      await api('POST', '/subgrupos', { lojistaId: empresaAtual(), grupoId: modo.grupoId, nome, descricao });
    } else {
      await api('PUT', `/subgrupos/${modo.subId}`, { lojistaId: empresaAtual(), nome, descricao });
    }
    fecharModal('modalSub');
    carregarEstrutura();
  } catch (err) { alert(err.message); }
});

async function suspender(subId, codigo) {
  if (!confirm(`Suspender o subgrupo ${codigo}?\n\nNada é apagado: ele sai das telas da empresa e pode ser reativado aqui.`)) return;
  try {
    const resp = await fetch(`${API}/subgrupos/${subId}?lojistaId=${empresaAtual()}`, { method: 'DELETE' });
    const dado = await resp.json().catch(() => ({}));
    if (!resp.ok) throw new Error(dado.erro || 'Erro.');
    carregarEstrutura();
  } catch (err) { alert(err.message); }
}

async function reativar(subId) {
  try {
    await api('POST', `/subgrupos/${subId}/reativar`, { lojistaId: empresaAtual() });
    carregarEstrutura();
  } catch (err) { alert(err.message); }
}

document.getElementById('btnClonar').addEventListener('click', () => {
  if (!empresaAtual()) { alert('Escolha primeiro a empresa que vai receber a estrutura.'); return; }
  abrirModal('modalClonar');
});

document.getElementById('btnConfirmarClonar').addEventListener('click', async () => {
  try {
    const r = await api('POST', '/clonar', { de: document.getElementById('selOrigem').value, para: empresaAtual() });
    fecharModal('modalClonar');
    alert(`${r.criados} subgrupo(s) criado(s). ${r.ignorados} já existiam.`);
    carregarEstrutura();
  } catch (err) { alert(err.message); }
});

/* Importação: conferir primeiro, aplicar depois. */
document.getElementById('btnImportar').addEventListener('click', () => {
  if (!empresaAtual()) { alert('Escolha primeiro a empresa.'); return; }
  document.getElementById('previaImport').innerHTML = '';
  document.getElementById('btnAplicarImport').disabled = true;
  mostrarHistorico();
  abrirModal('modalImportar');
});

/* Mostra as importações anteriores: no dia da virada é bom ver de que data
   era o último arquivo e se o que já entrou foi ensaio. */
async function mostrarHistorico() {
  const alvo = document.getElementById('historicoImport');
  alvo.innerHTML = '';
  try {
    const lista = await api('GET', `/importacoes/${empresaAtual()}`);
    if (!lista.length) { alvo.textContent = 'Nenhuma importação registrada para esta empresa.'; return; }
    alvo.innerHTML = '<strong>Importações anteriores:</strong><ul class="mb-0">' + lista.slice(0, 5).map(i => {
      const q = new Date(i.quando).toLocaleString('pt-BR');
      const ref = i.dataReferencia ? ` · documentos até ${new Date(i.dataReferencia + 'T00:00').toLocaleDateString('pt-BR')}` : '';
      const total = (i.criados?.subgrupo || 0) + (i.criados?.titulo || 0) + (i.criados?.subtitulo || 0);
      return `<li>${q} — ${total} conta(s)${ref} ${i.ensaio ? '<span class="etiqueta">ensaio</span>' : '<strong>virada</strong>'}</li>`;
    }).join('') + '</ul>';
  } catch { alvo.textContent = ''; }
}

async function enviarPlano(aplicar) {
  const arquivo = document.getElementById('arqPlano').files[0];
  if (!arquivo) { alert('Escolha o arquivo.'); return null; }
  const dados = new FormData();
  dados.append('arquivo', arquivo);
  dados.append('lojistaId', empresaAtual());
  dados.append('digitos', document.getElementById('selDigitos').value);
  dados.append('aplicar', aplicar ? 'true' : 'false');
  dados.append('dataReferencia', document.getElementById('dataReferencia').value);
  dados.append('ensaio', document.getElementById('chkEnsaio').checked ? 'true' : 'false');
  dados.append('atualizarNomes', document.getElementById('chkNomes').checked ? 'true' : 'false');

  const resp = await fetch(API + '/importar', { method: 'POST', body: dados });
  const r = await resp.json().catch(() => ({}));
  if (!resp.ok) { alert(r.erro || 'Erro na importação.'); return null; }
  return r;
}

document.getElementById('btnConferir').addEventListener('click', async () => {
  const alvo = document.getElementById('previaImport');
  alvo.innerHTML = '<p class="aviso">Conferindo...</p>';
  const r = await enviarPlano(false);
  if (!r) { alvo.innerHTML = ''; return; }

  window.__ultimaConferencia = r;
  const s = r.resumo;
  // Data vinda do arquivo tem preferência sobre o que estiver digitado
  if (r.referenciaDoArquivo) document.getElementById('dataReferencia').value = r.referenciaDoArquivo;
  alvo.innerHTML = `
    <div class="alert ${s.erros ? 'alert-warning' : 'alert-success'}">
      <strong>${s.lidas}</strong> conta(s) lida(s) —
      criar <strong>${s.criar}</strong>
      (${s.porNivel.subgrupo} subgrupos, ${s.porNivel.titulo} títulos, ${s.porNivel.subtitulo} subtítulos),
      já existem ${s.jaExistem}, com problema ${s.erros}.
    </div>
    ${s.erros ? `<div class="mb-3"><strong>Problemas:</strong><ul class="mb-0">${
      r.erros.slice(0, 15).map(e => `<li>linha ${e.linha} — ${e.codigo || ''} ${e.erro}</li>`).join('')
    }</ul>${r.errosTotal > 15 ? `<p class="aviso">e mais ${r.errosTotal - 15}.</p>` : ''}</div>` : ''}
    ${s.nomeMudou ? `<div class="mb-3"><strong>${s.nomeMudou} nome(s) mudaram no sistema antigo:</strong><ul class="mb-0">${
      r.nomeMudou.slice(0, 10).map(n => `<li><code>${n.codigo}</code> ${n.de} → <strong>${n.para}</strong></li>`).join('')
    }</ul><span class="aviso">Marque "atualizar nomes" para aplicar.</span></div>` : ''}
    ${s.soAqui ? `<div class="mb-3"><strong>${s.soAqui} conta(s) existem aqui e não vêm no arquivo:</strong><ul class="mb-0">${
      r.soAqui.slice(0, 10).map(c => `<li><code>${c.codigo}</code> ${c.nome}</li>`).join('')
    }</ul><span class="aviso">Nada é apagado; se foram desativadas lá, suspenda-as por aqui.</span></div>` : ''}
    ${r.novas.length ? `<div><strong>Amostra do que será criado:</strong>
      <ul class="mb-0">${r.novas.slice(0, 10).map(c => `<li><code>${c.codigo}</code> ${c.nome} <span class="aviso">(${c.nivel})</span></li>`).join('')}</ul></div>` : ''}`;

  // Libera também quando não há conta nova mas há nome para atualizar
  const temNomes = s.nomeMudou > 0 && document.getElementById('chkNomes').checked;
  document.getElementById('btnAplicarImport').disabled = s.erros > 0 || (s.criar === 0 && !temNomes);
});

document.getElementById('chkNomes').addEventListener('change', () => {
  const ultimo = window.__ultimaConferencia;
  if (!ultimo) return;
  const s = ultimo.resumo;
  const temNomes = s.nomeMudou > 0 && document.getElementById('chkNomes').checked;
  document.getElementById('btnAplicarImport').disabled = s.erros > 0 || (s.criar === 0 && !temNomes);
});

document.getElementById('btnAplicarImport').addEventListener('click', async () => {
  if (!confirm('Importar as contas conferidas para esta empresa?')) return;
  const botao = document.getElementById('btnAplicarImport');
  botao.disabled = true; botao.textContent = 'Importando...';
  const r = await enviarPlano(true);
  botao.textContent = 'Importar';
  if (r) {
    alert(`Importado: ${r.criados.subgrupo} subgrupos, ${r.criados.titulo} títulos, ${r.criados.subtitulo} subtítulos.` +
          (r.renomeados ? `\n${r.renomeados} nome(s) atualizado(s).` : '') +
          (r.soAqui ? `\n${r.soAqui} conta(s) existem aqui e não vieram no arquivo.` : ''));
    fecharModal('modalImportar');
    carregarEstrutura();
  }
});

document.getElementById('selEmpresa').addEventListener('change', carregarEstrutura);
document.getElementById('chkSuspensos').addEventListener('change', carregarEstrutura);

carregarEmpresas().catch(err => alert('Erro ao carregar empresas: ' + err.message));
</script>
</body>
</html>
