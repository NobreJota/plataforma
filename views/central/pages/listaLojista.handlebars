      /* ===== Grade: leitura, cabeçalho fixo e coluna Razão fixa ===== */

      /* O container é quem rola; o sticky se apoia nele. */
      #tabelaScroll {
        background-color: #fff;
        width: 100%;
        height: 78vh;
        margin: auto;
        overflow: auto;
        padding: 0;
        position: relative;
      }

      #tabelaLojistas {
        font-size: .875rem;          /* era small */
        font-weight: 400;            /* era 300 */
        color: #1f2937;              /* cinza bem escuro, no lugar do cinza claro */
        margin-bottom: 0;
        border-collapse: separate;   /* necessário para a borda acompanhar o sticky */
        border-spacing: 0;
      }

      #tabelaLojistas td, #tabelaLojistas th { border: 1px solid #dee2e6; }

      /* Cabeçalho preso ao topo */
      #tabelaLojistas thead th {
        position: sticky;
        top: 0;
        z-index: 3;
        background-color: #eef1f5;
        color: #111827;
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .02em;
        padding: 10px 8px;
        white-space: nowrap;
        cursor: pointer;
        user-select: none;
      }

      /* Coluna Razão presa à esquerda: é a âncora da linha, por isso não se esconde */
      #tabelaLojistas tbody td:first-child,
      #tabelaLojistas thead th:first-child {
        position: sticky;
        left: 0;
        background-color: #fff;
        z-index: 2;
        box-shadow: 1px 0 0 #cfd4da;   /* separa visualmente do resto ao rolar */
        font-weight: 500;
      }
      /* O cruzamento (cabeçalho da Razão) fica acima dos dois */
      #tabelaLojistas thead th:first-child { background-color: #eef1f5; z-index: 4; }

      #tabelaLojistas tbody tr:nth-child(even) td { background-color: #f7f9fa; }
      #tabelaLojistas tbody tr:nth-child(even) td:first-child { background-color: #f7f9fa; }
      #tabelaLojistas tbody tr:hover td { background-color: #eaf3ff; }

      /* "x" de esconder: aparece só quando o mouse passa, para o clique no
         título continuar livre para ordenar (Ctrl + clique) */
      #tabelaLojistas thead th .fechar-col {
        float: right;
        margin-left: 8px;
        color: #4b5563;
        font-weight: 700;
        visibility: hidden;
      }
      #tabelaLojistas thead th:hover .fechar-col { visibility: visible; }
      #tabelaLojistas thead th .fechar-col:hover { color: #bb0404; }

      /* Complemento e Status: quem forçava a largura era o título, e max-width
         não vale em célula de tabela com layout automático. Então limita-se o
         texto do cabeçalho, que quebra em duas linhas, e a coluna acompanha. */
      #tabelaLojistas th.col-estreita { white-space: normal; }
      #tabelaLojistas th.col-estreita .rotulo {
        display: inline-block;
        max-width: 70px;
        overflow-wrap: anywhere;
        line-height: 1.15;
      }
      #tabelaLojistas td:nth-child(12),
      #tabelaLojistas td:nth-child(17) { min-width: 70px; }

      /* ===== Barra do rodapé: devolve as colunas escondidas ===== */
      /* Margens folgadas nas pontas; o espaço do meio é dividido em dois,
         com os dois grupos equidistantes. O contador fica encostado à direita,
         fora dessa divisão, para não desequilibrar. */
      #barraColunas {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-around;
        padding: 12px 6vw;
        background: #eef1f5;
        border-top: 1px solid #cfd4da;
        font-size: .9rem;
        color: #1f2937;
      }
      #barraColunas .grupo { display: flex; align-items: center; gap: 10px; }
      #barraColunas label { font-weight: 600; color: #111827; margin: 0; }
      #barraColunas select {
