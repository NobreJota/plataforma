{{!--
  Destino: C:\plataformaRota\views\vendas\pages\servicos.handlebars
  Criado em: 10/10/2026

  SERVICO > AGENDA DO DIA: o que os tecnicos tem para fazer num dia.
  Grade: horarios (07:00 a 19:00, de 30 em 30 min) x tecnicos. Cada servico mostra o
  cliente; clique abre os detalhes (endereco, telefones, o que instalar, OS/venda).
  Servico sem horario fica numa lista embaixo. OS = venda fechada; "reserva" = venda
  ainda aberta com a instalacao ja marcada.

  O JS fica em /js/vendas/servicos.js   API: /vendas/api/venda/servicos?dia=

  Alterado em: 13/10/2026 - a grade tem uma coluna para CADA tecnico ativo, mesmo sem
               servico no dia. No topo, duas abas: "Agenda do dia" (a grade) e
               "A agendar" (OS pendente e reserva sem dia ou sem horario, de qualquer data).
               Clique na OS abre o modal da OS (/js/vendas/os-modal.js).
--}}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agenda do dia</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root { --ambar:#92400e; --ambar-claro:#fef3c7; --borda:#e5e7eb; --texto:#111827; --cinza:#6b7280;
            --verde:#059669; --vermelho:#dc2626; }
    body { margin:0 auto; max-width:1500px; padding:52px 32px 40px; color:var(--texto); background:#fff;
           font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size:14px; }
    .topo { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:14px; }
    .topo h1 { margin:0 12px 0 0; font-size:21px; }
    .topo button { height:34px; border:1px solid #d1d5db; background:#fff; border-radius:8px; padding:0 12px;
                   font-weight:600; cursor:pointer; }
    .topo button.hoje { background:var(--ambar); border-color:var(--ambar); color:#fff; }
    .topo input[type=date] { height:34px; border:1px solid #d1d5db; border-radius:8px; padding:0 8px; font-size:14px; font-weight:600; }
    .topo .dia-nome { font-size:15px; font-weight:700; color:var(--ambar); }
    .topo .resumo { margin-left:auto; color:var(--cinza); font-size:13px; }

    .grade { border:1px solid var(--borda); border-radius:10px; overflow:auto; max-height:calc(100vh - 230px); }
    table { border-collapse:collapse; width:100%; table-layout:fixed; }
    th { position:sticky; top:0; z-index:2; background:var(--ambar); color:#fff; font-size:12px; text-align:left;
         padding:8px 10px; white-space:nowrap; }
    th.h, td.h { position:sticky; left:0; z-index:1; width:72px; }
    th.h { z-index:3; }
    td { border-top:1px solid #f3f4f6; border-left:1px solid #f3f4f6; padding:0; height:30px; vertical-align:top; }
    td.h { background:#f8fafc; font-weight:700; font-variant-numeric:tabular-nums; padding:6px 10px; }
    tr.cheia td.h { color:var(--texto); } tr.meia td.h { color:var(--cinza); font-weight:500; }
    .sv { margin:2px; padding:4px 8px; border-radius:6px; cursor:pointer; background:var(--ambar-claro);
          border-left:4px solid #d97706; height:calc(100% - 4px); overflow:hidden; }
    .sv:hover { background:#fde68a; }
    .sv.reserva { background:#eff6ff; border-left-color:#2563eb; }
    .sv.feita { background:#d1fae5; border-left-color:#059669; }
    .sv b { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sv small { color:#374151; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .vazio { padding:30px; text-align:center; color:var(--cinza); }
    .abas { display:flex; gap:4px; border-bottom:2px solid var(--ambar); margin-bottom:10px; }
    .abas button { border:1px solid var(--borda); border-bottom:0; background:#f8fafc; border-radius:8px 8px 0 0;
                   padding:8px 18px; font-weight:700; font-size:14px; cursor:pointer; color:#374151; }
    .abas button.ativa { background:var(--ambar); border-color:var(--ambar); color:#fff; }
    .abas .n { display:inline-block; min-width:22px; margin-left:6px; padding:1px 7px; border-radius:11px;
               background:var(--vermelho); color:#fff; font-size:12px; }
    .abas .n.zero { background:#d1d5db; color:#374151; }
    .pend { border:1px solid #fde68a; background:#fffbeb; border-radius:10px; padding:10px 14px;
            display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:8px;
            max-height:calc(100vh - 230px); overflow:auto; }
    .pend .sv { height:auto; margin:0; }
    .pend .vazio { grid-column:1 / -1; }
    .sv .dia { float:right; font-size:11px; font-weight:700; color:var(--ambar); }
    .sv .dia.sem { color:var(--vermelho); }
    [hidden] { display:none !important; }
    .legenda { margin-top:10px; font-size:12px; color:var(--cinza); display:flex; gap:16px; }
    .legenda span::before { content:''; display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:5px;
                            vertical-align:-2px; background:var(--ambar-claro); border-left:4px solid #d97706; }
    .legenda span.r::before { background:#eff6ff; border-left-color:#2563eb; }
    .legenda span.f::before { background:#d1fae5; border-left-color:#059669; }

    .fundo { position:fixed; inset:0; background:rgba(15,23,42,.25); z-index:40; }
    .fundo[hidden], .caixa[hidden] { display:none; }
    .caixa { position:fixed; top:8vh; left:50%; transform:translateX(-50%); z-index:41; width:min(640px, calc(100vw - 32px));
             max-height:84vh; overflow:auto; background:#fff; border-radius:12px; box-shadow:0 18px 50px rgba(0,0,0,.3); }
    .caixa h3 { margin:0; padding:14px 20px; background:var(--ambar); color:#fff; font-size:17px; border-radius:12px 12px 0 0;
                display:flex; justify-content:space-between; }
    .caixa h3 button { border:0; background:none; color:#fff; font-size:22px; cursor:pointer; }
    .det { padding:14px 20px 18px; display:grid; grid-template-columns:120px minmax(0,1fr); gap:6px 12px; }
    .det span { font-size:11px; font-weight:700; text-transform:uppercase; color:#374151; padding-top:2px; }
    .det ul { margin:0; padding-left:18px; }
    @media print {
      body { padding:0; max-width:none; } .topo button, .topo input, #nav-comum { display:none; }
      .grade { max-height:none; overflow:visible; } th { position:static; }
    }
  </style>
</head>
<body>

  <div class="topo">
    <h1>Agenda do dia</h1>
    <button type="button" id="ant" title="dia anterior">◀</button>
    <input type="date" id="dia">
    <button type="button" id="prox" title="próximo dia">▶</button>
    <button type="button" id="hoje" class="hoje">Hoje</button>
    <span class="dia-nome" id="dia-nome"></span>
    <button type="button" id="imprimir">Imprimir</button>
    <span class="resumo" id="resumo"></span>
  </div>

  <div class="abas">
    <button type="button" class="ativa" data-aba="agenda">Agenda do dia</button>
    <button type="button" data-aba="pend" title="OS pendente e reserva sem dia ou sem horário">A agendar<span class="n zero" id="n-pend">0</span></button>
  </div>
  <div class="grade" id="grade"><div class="vazio">Carregando…</div></div>
  <div class="pend" id="pend" hidden></div>
  <div class="legenda"><span>OS (venda fechada)</span><span class="r">reserva (venda ainda aberta)</span><span class="f">serviço concluído</span></div>

  <div class="fundo" id="fundo" hidden></div>
  <div class="caixa" id="caixa" hidden role="dialog">
    <h3><span id="cx-tit">Serviço</span><button type="button" id="cx-x" title="fechar (Esc)">×</button></h3>
    <div class="det" id="cx-det"></div>
  </div>

  <script src="/js/vendas/os-modal.js"></script>
  <script src="/js/vendas/servicos.js"></script>
  <script src="/js/comum/navegacao.js"></script>
</body>
</html>
