<script>
/* Esconder e devolver colunas.
   O índice vem da posição real da célula (cellIndex), não de um data-column
   escrito à mão — os antigos estavam repetidos (Logradouro e Numero eram os
   dois "9"), e daí em diante escondia-se a coluna errada.
   Clique no "x" esconde; Ctrl + clique no título ordena. */
(function () {
  const tabela   = document.getElementById("tabelaLojistas");
  const combo    = document.getElementById("selColunas");
  const contador = document.getElementById("contadorLinhas");
  if (!tabela) return;

  const escondidas = new Map();   // índice → nome da coluna

  function aplicar(indice, esconder) {
    tabela.querySelectorAll("tr").forEach(linha => {
      const celula = linha.children[indice];
      if (celula) celula.style.display = esconder ? "none" : "";
    });
  }

  function atualizarCombo() {
    if (!combo) return;
    if (!escondidas.size) {
      combo.innerHTML = '<option value="">nenhuma</option>';
      return;
    }
    combo.innerHTML = [...escondidas.entries()]
      .sort((a, b) => a[0] - b[0])
      .map(([i, nome]) => `<option value="${i}">${nome}</option>`)
      .join("");
  }

  function esconder(th) {
    const i = th.cellIndex;
    if (escondidas.has(i)) return;
    const rotulo = th.querySelector(".rotulo");
    escondidas.set(i, (rotulo || th.childNodes[0]).textContent.trim());
    aplicar(i, true);
    atualizarCombo();
  }

  function mostrar(i) {
    if (!escondidas.has(i)) return;
    escondidas.delete(i);
    aplicar(i, false);
    atualizarCombo();
  }

  tabela.querySelectorAll("thead th.click-hide").forEach(th => {
    th.addEventListener("click", (e) => {
      if (e.ctrlKey) {              // Ctrl + clique ordena pela coluna
        const i = th.cellIndex;
        const corpo = tabela.querySelector("tbody");
        const linhas = Array.from(corpo.querySelectorAll("tr"));
        linhas.sort((a, b) =>
          (a.children[i]?.textContent || "").trim().toLowerCase()
            .localeCompare((b.children[i]?.textContent || "").trim().toLowerCase(), "pt")
        );
        linhas.forEach(l => corpo.appendChild(l));
        return;
      }
      if (e.target.classList.contains("fechar-col")) esconder(th);
    });
  });

  document.getElementById("btnMostrarColuna")?.addEventListener("click", () => {
    const i = parseInt(combo.value, 10);
    if (!Number.isNaN(i)) mostrar(i);
  });

  document.getElementById("btnMostrarTodas")?.addEventListener("click", () => {
    [...escondidas.keys()].forEach(i => aplicar(i, false));
    escondidas.clear();
    atualizarCombo();
  });

  if (contador) {
    const n = tabela.querySelectorAll("tbody tr").length;
    contador.textContent = `${n} lojista${n === 1 ? "" : "s"}`;
  }
})();
</script>
<script>
    document.querySelectorAll("td[contenteditable=true]").forEach(cell => {
      cell.addEventListener("blur", async () => {
        const row = cell.closest("tr");
        const id = row.dataset.id;
        const field = cell.dataset.field;
        const value = cell.textContent.trim();
        try {
          console.log("Update lojista /:id",id)
          const response = await fetch(`/lojista/lojista/update/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ [field]: value })
          });
          const result = await response.json();
          if (response.ok) {
            cell.style.backgroundColor = "#c8f7c5";
            setTimeout(() => cell.style.backgroundColor = "", 1000);
          } else {
            alert("Erro ao atualizar.");
          }
        } catch (error) {
          console.error("Falha na atualização:", error);
          alert("Erro na comunicação.");
        }
      });
    });
</script>
