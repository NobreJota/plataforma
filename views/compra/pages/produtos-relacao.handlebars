<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relação de produtos</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --roxo: #6b21a8;
      --roxo-claro: #f3e8ff;
      --borda: #e5e7eb;
      --texto: #1f2937;
      --cinza: #6b7280;
      --verde: #059669;
      --vermelho: #dc2626;
    }

    html, body { height: 100%; }
    body {
      margin: 0; padding: 16px 20px 12px;
      background: #fff; color: var(--texto);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      font-size: 14px;
      display: flex; flex-direction: column; overflow: hidden;
    }

    h1 {
      font-size: 21px; margin: 0 0 14px; font-weight: 700; flex: none;
      display: flex; align-items: baseline; gap: 12px;
    }
    h1 small { font-size: 13px; font-weight: 400; color: var(--cinza); }

    .barra { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; flex: none; }
    .barra label.rot { font-size: 11px; font-weight: 700; text-transform: uppercase; color: #374151; }
    .barra select, .barra input[type=search] {
      height: 38px; border: 1px solid var(--borda); border-radius: 8px;
      padding: 0 12px; font-size: 14px; color: var(--texto); background: #fff;
    }
    .barra select { min-width: 280px; }
    .barra input[type=search] { flex: 1; }
    .barra select:focus, .barra input:focus { outline: 2px solid var(--roxo-claro); border-color: var(--roxo); }
    .barra .chk { display: flex; gap: 6px; align-items: center; font-size: 13px; color: #374151; white-space: nowrap; }
    .conta { font-size: 13px; color: var(--cinza); white-space: nowrap; }

    .quadro {
      flex: 1; min-height: 0; overflow: auto;
      border: 1px solid var(--borda); border-radius: 10px;
    }
    table { width: 100%; border-collapse: collapse; }
    thead th {
      position: sticky; top: 0; z-index: 1;
      background: #f8fafc; border-bottom: 1px solid var(--borda);
      font-size: 11px; text-transform: uppercase; letter-spacing: .03em;
      color: #374151; text-align: left; padding: 9px 10px; white-space: nowrap;
    }
    tbody td { padding: 7px 10px; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    tbody tr:hover td { background: #faf5ff; }
    tbody tr[data-cod] { cursor: pointer; }
    tbody tr.inativo td { color: var(--cinza); }
    tfoot td {
      position: sticky; bottom: 0; background: #f8fafc; border-top: 1px solid var(--borda);
      padding: 9px 10px; font-weight: 700;
    }
    .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    code { font-size: 12px; background: #f1f5f9; padding: 1px 5px; border-radius: 4px; }
    .zero { color: var(--vermelho); }
    .forn { font-size: 12px; color: var(--cinza); }

    .vazio { padding: 48px 20px; text-align: center; color: var(--cinza); }
    .vazio strong { display: block; color: var(--texto); margin-bottom: 4px; }
  </style>
</head>
<body>

  <h1>Relação de produtos <small>o que está cadastrado, por fornecedor</small></h1>

  <div class="barra">
    <label class="rot" for="fornecedor">Fornecedor</label>
    <select id="fornecedor"><option value="">Carregando…</option></select>
    <input type="search" id="busca" placeholder="Buscar por descrição, referência, marca ou código…" autocomplete="off">
    <label class="chk"><input type="checkbox" id="comEstoque"> só com estoque</label>
    <span class="conta" id="conta"></span>
  </div>

  <div class="quadro">
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Descrição</th>
          <th>Referência</th>
          <th>Marca</th>
          <th class="num">Estoque</th>
          <th class="num">Custo</th>
          <th class="num">À vista</th>
          <th class="num">A prazo</th>
          <th class="num">Taxa %</th>
          <th class="num">Estoque a custo</th>
        </tr>
      </thead>
      <tbody id="linhas">
        <tr><td colspan="10"><div class="vazio"><strong>Escolha um fornecedor</strong>Ou busque por descrição, referência, marca ou código.</div></td></tr>
      </tbody>
      <tfoot id="rodape" hidden>
        <tr>
          <td colspan="4" id="rodapeTexto"></td>
          <td class="num" id="rodapeQte"></td>
          <td colspan="4"></td>
          <td class="num" id="rodapeValor"></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <script src="/js/compra/produtos-relacao.js"></script>
</body>
</html>
