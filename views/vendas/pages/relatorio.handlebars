{{!--
  Destino: C:\plataformaRota\views\vendas\pages\relatorio.handlebars
  Criado em: 03/10/2026

  RELATORIO DE VENDAS, mes a mes (como o Fluxo de Caixa): botoes Jan..Dez,
  "todos" e o ano. Uma linha por venda; duplo clique abre a venda.
  Rodape: cupons, notas e o total do periodo (canceladas fora da soma).
  Por enquanto so as vendas feitas na plataforma (_vendas).

  O JS fica em /js/vendas/relatorio.js  (caminho completo, sempre)
--}}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório de vendas</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root { --roxo:#6b21a8; --roxo-claro:#f3e8ff; --borda:#e5e7eb; --texto:#111827; --cinza:#6b7280;
            --verde:#059669; --vermelho:#dc2626; --ambar:#d97706; }
    body { margin:0 auto; max-width:1400px; padding:20px 40px 40px; color:var(--texto); background:#fff;
           font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; font-size:14px; }
    .topo { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:14px; }
    .topo h1 { margin:0; font-size:21px; }
    .topo a { color:var(--roxo); font-size:13px; text-decoration:none; }

    .meses { display:flex; gap:6px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }
    .meses button { flex:1 1 0; min-width:56px; height:32px; border:1px solid #d1d5db; background:#fff;
                    border-radius:6px; font-size:13px; font-weight:600; color:#374151; cursor:pointer; }
    .meses button.ativo { background:var(--roxo); border-color:var(--roxo); color:#fff; }
    .meses .todos { flex:0 0 auto; padding:0 14px; margin-left:8px; }
    .meses label { margin-left:10px; font-weight:700; font-size:13px; }
    .meses select { height:32px; border:1px solid #d1d5db; border-radius:6px; padding:0 8px; font-size:14px; font-weight:600; }

    .grade { border:1px solid var(--borda); border-radius:10px; overflow:auto; }
    table { width:100%; border-collapse:collapse; }
    th { background:var(--roxo); color:#fff; text-align:left; font-size:12px; padding:8px 10px; white-space:nowrap; }
    td { padding:7px 10px; border-bottom:1px solid #f3f4f6; }
    tbody tr.v:nth-child(even) td { background:#f9fafb; }
    tbody tr.v { cursor:pointer; }
    tbody tr.v:hover td { background:#ede9fe; }
    tr.sep td { background:var(--roxo-claro); color:var(--roxo); font-weight:700; font-size:12px;
                text-transform:uppercase; letter-spacing:.04em; }
    .n { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .cinza { color:var(--cinza); font-size:12px; }
    .etq { display:inline-block; font-size:11px; font-weight:700; border-radius:4px; padding:1px 6px; }
    .etq.cupom { background:#ecfdf5; color:var(--verde); }
    .etq.nfe { background:#eff6ff; color:#1d4ed8; }
    .sit-A { color:var(--ambar); } .sit-F { color:var(--verde); } .sit-C { color:var(--vermelho); text-decoration:line-through; }
    tr.cancelada td { color:var(--cinza); }
    .vazio { padding:24px; text-align:center; color:var(--cinza); }

    .rodape { display:flex; justify-content:flex-end; gap:32px; margin-top:12px; padding:12px 16px;
              background:#f8fafc; border-radius:10px; }
    .rodape .t { text-align:right; }
    .rodape .t span { display:block; font-size:11px; text-transform:uppercase; color:#374151; font-weight:700; }
    .rodape .t b { font-size:16px; font-variant-numeric:tabular-nums; }
    .rodape .t small { display:block; color:var(--cinza); font-size:12px; }
    .rodape .liq b { font-size:20px; color:var(--roxo); }
    .recado { color:var(--vermelho); font-size:13px; margin-top:8px; }
  </style>
</head>
<body>

  <div class="topo">
    <h1>Relatório de vendas</h1>
    <a href="/vendas/venda">+ nova venda</a>
  </div>

  <div class="meses" id="meses">
    <button type="button" data-m="1">Jan</button><button type="button" data-m="2">Fev</button>
    <button type="button" data-m="3">Mar</button><button type="button" data-m="4">Abr</button>
    <button type="button" data-m="5">Mai</button><button type="button" data-m="6">Jun</button>
    <button type="button" data-m="7">Jul</button><button type="button" data-m="8">Ago</button>
    <button type="button" data-m="9">Set</button><button type="button" data-m="10">Out</button>
    <button type="button" data-m="11">Nov</button><button type="button" data-m="12">Dez</button>
    <button type="button" data-m="0" class="todos">todos</button>
    <label for="ano">Ano:</label>
    <select id="ano"></select>
  </div>

  <div class="grade">
    <table>
      <thead>
        <tr><th class="n">#</th><th>Venda</th><th>Data</th><th>Documento</th><th>Cliente</th>
            <th>Condição</th><th>Situação</th><th class="n">Itens</th><th class="n">Bruto</th>
            <th class="n">Desconto</th><th class="n">Líquido</th></tr>
      </thead>
      <tbody id="linhas"><tr><td colspan="11" class="vazio">Carregando…</td></tr></tbody>
    </table>
  </div>

  <div class="rodape">
    <div class="t"><span>Cupons</span><b id="t-cupom">0,00</b><small id="q-cupom">0 vendas</small></div>
    <div class="t"><span>Notas fiscais</span><b id="t-nfe">0,00</b><small id="q-nfe">0 vendas</small></div>
    <div class="t"><span>Descontos</span><b id="t-desc">0,00</b><small>&nbsp;</small></div>
    <div class="t liq"><span>Líquido do período</span><b id="t-liq">0,00</b><small id="q-total">0 vendas</small></div>
  </div>
  <div class="recado" id="recado"></div>

  <script src="/js/vendas/relatorio.js"></script>
</body>
</html>
