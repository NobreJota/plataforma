<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Entrada de Mercadoria</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --roxo: #6b21a8;
      --roxo-claro: #f3e8ff;
      --borda: #e5e7eb;
      --texto: #1f2937;
      --cinza: #6b7280;

      --recebida: #2563eb;
      --vinculada: #7c3aed;
      --conferencia: #d97706;
      --efetivada: #059669;
      --recusada: #dc2626;
    }

    html, body { height: 100%; }
    body {
      background: #fff;
      color: var(--texto);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      font-size: 15px;
      margin: 0;
      padding: 20px 28px 14px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .topo {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; margin-bottom: 18px; flex: none;
    }
    h1 small {
      display: block; font-size: 13px; font-weight: 400; color: var(--cinza);
      margin-top: 2px; letter-spacing: 0;
    }
    h1 {
      font-size: 22px; font-weight: 700; margin: 0;
      display: flex; align-items: center; gap: 10px;
    }
    h1 .icone { font-size: 24px; }

    .btn-principal {
      background: var(--roxo); color: #fff; border: none; border-radius: 6px;
      padding: 11px 22px; font-size: 15px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-principal:hover { background: #581c87; }

    /* ---------- cartoes de situacao ---------- */
    .cartoes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px; margin-bottom: 18px; flex: none;
    }
    .cartao {
      border: 1px solid var(--borda); border-left-width: 4px;
      border-radius: 8px; padding: 12px 14px;
      cursor: pointer; background: #fff;
      transition: background .12s;
    }
    .cartao:hover { background: #fafafa; }
    .cartao.ativo { background: var(--roxo-claro); border-color: var(--roxo); }
    .cartao .rotulo {
      font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
      color: var(--cinza); font-weight: 600;
    }
    .cartao .numero { font-size: 26px; font-weight: 700; line-height: 1.1; margin-top: 2px; }
    .cartao .valor { font-size: 12px; color: var(--cinza); }

    .cartao[data-s="RECEBIDA"]       { border-left-color: var(--recebida); }
    .cartao[data-s="VINCULADA"]      { border-left-color: var(--vinculada); }
    .cartao[data-s="EM_CONFERENCIA"] { border-left-color: var(--conferencia); }
    .cartao[data-s="EFETIVADA"]      { border-left-color: var(--efetivada); }
    .cartao[data-s="RECUSADA"]       { border-left-color: var(--recusada); }

    /* ---------- busca ---------- */
    .barra { display: flex; gap: 12px; margin-bottom: 14px; flex: none; }
    input[type="text"] {
      flex: 1 1 auto;
      border: 1px solid var(--borda); border-radius: 6px;
      padding: 10px 14px; font-size: 15px;
    }
    input:focus {
      outline: none; border-color: var(--roxo);
      box-shadow: 0 0 0 2px var(--roxo-claro);
    }

    /* ---------- lista ---------- */
    .lista-area {
      flex: 1 1 auto; min-height: 120px; overflow: auto;
      border: 1px solid var(--borda); border-radius: 8px;
    }

    .nota {
      display: grid;
      grid-template-columns: 130px 1fr 150px 130px 140px;
      gap: 14px; align-items: center;
      padding: 14px 16px;
      border-bottom: 1px solid #f3f4f6;
      cursor: pointer;
      background: #fff;
    }
    .nota:hover { background: #fafafa; }
    .nota:last-child { border-bottom: none; }

    .nota .num { font-weight: 700; font-size: 16px; }
    .nota .num small { display: block; font-weight: 400; font-size: 12px; color: var(--cinza); }
    .nota .razao { font-weight: 600; }
    .nota .razao small { display: block; font-weight: 400; font-size: 12px; color: var(--cinza); }
    .nota .dinheiro { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }

    .etiqueta {
      display: inline-block; font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .03em;
      padding: 3px 9px; border-radius: 10px; color: #fff;
    }
    .etiqueta.RECEBIDA       { background: var(--recebida); }
    .etiqueta.VINCULADA      { background: var(--vinculada); }
    .etiqueta.EM_CONFERENCIA { background: var(--conferencia); }
    .etiqueta.EFETIVADA      { background: var(--efetivada); }
    .etiqueta.RECUSADA       { background: var(--recusada); }

    .progresso {
      height: 6px; background: #f3f4f6; border-radius: 3px;
      overflow: hidden; margin-top: 6px;
    }
    .progresso span {
      display: block; height: 100%; background: var(--conferencia);
      border-radius: 3px;
    }
    .progresso-texto { font-size: 11px; color: var(--cinza); margin-top: 3px; }

    .pedido-chip {
      display: inline-block; font-size: 11px; font-weight: 600;
      background: var(--roxo-claro); color: var(--roxo);
      padding: 2px 8px; border-radius: 10px; margin-top: 4px;
    }

    .aviso { padding: 48px 24px; text-align: center; color: var(--cinza); }
    .aviso strong { display: block; font-size: 17px; color: var(--texto); margin-bottom: 6px; }

    /* ---------- modal de importacao ---------- */
    .fundo-modal {
      display: none; position: fixed; inset: 0;
      background: rgba(17,24,39,.55); z-index: 50;
      align-items: center; justify-content: center; padding: 24px;
    }
    .fundo-modal.aberto { display: flex; }
    .modal {
      background: #fff; border-radius: 10px;
      width: 100%; max-width: 560px;
      box-shadow: 0 20px 50px rgba(0,0,0,.3);
    }
    .modal-topo {
      padding: 16px 22px; border-bottom: 1px solid var(--borda);
      display: flex; align-items: center; justify-content: space-between;
    }
    .modal-topo h2 { font-size: 17px; font-weight: 700; margin: 0; }
    .fechar {
      background: none; border: none; font-size: 26px; line-height: 1;
      color: var(--cinza); cursor: pointer; padding: 0 4px;
    }
    .modal-corpo { padding: 22px; }
    .modal-rodape {
      padding: 14px 22px; border-top: 1px solid var(--borda);
      display: flex; justify-content: flex-end; gap: 10px;
    }
    .btn-secundario {
      background: #fff; color: var(--texto); border: 1px solid var(--borda);
      border-radius: 6px; padding: 10px 20px; font-size: 15px; cursor: pointer;
    }

    .solta {
      border: 2px dashed var(--borda); border-radius: 10px;
      padding: 40px 20px; text-align: center; color: var(--cinza);
      cursor: pointer; transition: all .12s;
    }
    .solta:hover, .solta.sobre {
      border-color: var(--roxo); background: var(--roxo-claro); color: var(--roxo);
    }
    .solta .icone-grande { font-size: 40px; display: block; margin-bottom: 10px; }
    .solta strong { display: block; color: var(--texto); font-size: 16px; margin-bottom: 4px; }

    #arquivos { display: none; }
    .escolhidos { margin-top: 14px; font-size: 14px; }
    .escolhidos div { padding: 5px 0; border-bottom: 1px solid #f3f4f6; }

    /* ---------- tablet ---------- */
    @media (max-width: 860px) {
      body { padding: 14px 16px 10px; }
      .nota {
        grid-template-columns: 1fr auto;
        grid-template-areas:
          "num    etiqueta"
          "razao  razao"
          "prog   dinheiro";
        gap: 8px 12px;
      }
      .nota .num      { grid-area: num; }
      .nota .situacao { grid-area: etiqueta; text-align: right; }
      .nota .razao    { grid-area: razao; }
      .nota .prog     { grid-area: prog; }
      .nota .dinheiro { grid-area: dinheiro; }
      .cartoes { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <div class="topo">
    <h1><span class="icone">📦</span> Entrada de Mercadoria<small>o que chegou e ainda não terminou</small></h1>
    <button class="btn-principal" id="btn-importar">
      <span>＋</span> Importar XML
    </button>
  </div>

  <div class="cartoes" id="cartoes"></div>

  <div class="lista-area">
    <div id="lista">
      <div class="aviso">Carregando...</div>
    </div>
  </div>

  <!-- ============ modal de importacao ============ -->
  <div class="fundo-modal" id="fundo-modal">
    <div class="modal">
      <div class="modal-topo">
        <h2>Importar nota fiscal</h2>
        <button class="fechar" id="fechar-modal" title="Fechar">&times;</button>
      </div>

      <div class="modal-corpo">
        <div class="solta" id="solta">
          <span class="icone-grande">📄</span>
          <strong>Arraste os arquivos XML aqui</strong>
          ou clique para escolher
        </div>
        <input type="file" id="arquivos" accept=".xml,text/xml" multiple>
        <div class="escolhidos" id="escolhidos"></div>
      </div>

      <div class="modal-rodape">
        <button class="btn-secundario" id="cancelar-modal">Cancelar</button>
        <button class="btn-principal" id="enviar-xml" disabled>Importar</button>
      </div>
    </div>
  </div>

  <script src="/js/compra/entrada.js"></script>
</body>
</html>