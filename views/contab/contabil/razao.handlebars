{{!-- views/contab/contabil/razao.handlebars --}}

<div class="contab-app">

  {{!-- ====== SIDEBAR FINA (só ícones) ====== --}}
  <nav class="cb-side">
    <a class="cb-side-item" href="/financeiro/fluxo" title="Fluxo de Caixa">
      <i class="ti ti-cash" aria-hidden="true"></i>
    </a>
    <a class="cb-side-item active" href="#" title="Contabilidade">
      <i class="ti ti-calculator" aria-hidden="true"></i>
    </a>
    <a class="cb-side-item" href="/aux/fornecedores" title="Compra">
      <i class="ti ti-shopping-cart" aria-hidden="true"></i>
    </a>
    <a class="cb-side-item" href="/aux/clientes" title="Venda">
      <i class="ti ti-tag" aria-hidden="true"></i>
    </a>
    <a class="cb-side-item" href="/site/configuracoes" title="Site">
      <i class="ti ti-world" aria-hidden="true"></i>
    </a>
  </nav>

  {{!-- ====== SUBMENU (Contabilidade) ====== --}}
  <aside class="cb-submenu">
    <div class="cb-submenu-title">CONTABILIDADE</div>
    <a class="cb-sub-item" href="/contab/plano">Plano de contas</a>
    <a class="cb-sub-item active" href="/contab/razao">Razão</a>
    <a class="cb-sub-item" href="/contabil/pessoal">Pessoal</a>
    <a class="cb-sub-item" href="/contabil/relatorios">Relatórios</a>
  </aside>

  {{!-- ====== CONTEÚDO ====== --}}
  <main class="cb-content rz-page">

    {{!-- ====== BARRA: GRUPOS (Ativo/Passivo/Despesas/Receitas) ====== --}}
    <div class="rz-grupos">
      <div class="rz-tabs">
        <button class="rz-tab active" data-grupo="1">Ativo</button>
        <button class="rz-tab" data-grupo="2">Passivo</button>
        <button class="rz-tab" data-grupo="3">Despesas</button>
        <button class="rz-tab" data-grupo="4">Receitas</button>
      </div>
      {{!-- Quinta parte da linha: o filtro de período, sempre visível.
            Antes era um popup que abria ao clicar; virou campo fixo porque é
            usado em toda consulta. --}}
      <div class="rz-periodo-box">
        <label>De <input type="date" id="rz-de"></label>
        <label>Até <input type="date" id="rz-ate"></label>
        <button class="rz-btn" id="rz-periodo-aplicar">Aplicar</button>
      </div>
    </div>

    {{!-- ====== BARRA: COMBOS (Conta-título + Subtítulo + Busca) ====== --}}
    <div class="rz-combos">
      <div class="rz-combo" id="rz-combo-titulo" tabindex="0">
        <span class="rz-combo-label">CONTA-TÍTULO</span>
        <span class="rz-combo-value" id="rz-titulo-value">Selecione...</span>
        <i class="rz-chev">▾</i>
        <div class="rz-dropdown" id="rz-titulo-list" hidden></div>
      </div>

      <div class="rz-combo" id="rz-combo-subtitulo" tabindex="0">
        <span class="rz-combo-label">SUBTÍTULO</span>
        <span class="rz-combo-value" id="rz-sub-value">Selecione um título...</span>
        <i class="rz-chev">▾</i>
        <div class="rz-dropdown" id="rz-sub-list" hidden></div>
      </div>

      <div class="rz-search">
        <span class="rz-search-icon">🔍</span>
        <input type="text" id="rz-busca" placeholder="busca rápida por nome" autocomplete="off">
        <div class="rz-dropdown" id="rz-busca-list" hidden></div>
      </div>
    </div>

    {{!-- ====== BARRA: PERÍODO + TOTAIS ====== --}}
    <div class="rz-totais">

      {{!-- Menu de ações, à esquerda --}}
      <nav class="rz-menu">
        <div class="rz-menu-item" id="rz-menu-lanc">
          Lançamentos <i class="rz-chev">▾</i>
          <div class="rz-menu-drop" id="rz-menu-lanc-drop" hidden>
            <button class="rz-menu-opt" data-acao="lanc-credito">Crédito</button>
            <button class="rz-menu-opt" data-acao="lanc-debito">Débito</button>
          </div>
        </div>
        <a class="rz-menu-item" href="/contab/saldo-transferido">Transferir saldo</a>
        <button class="rz-menu-item" id="rz-menu-imprimir">Imprimir</button>
      </nav>

      {{!-- Totais, à direita --}}
      <div class="rz-direita">
        <span class="rz-resumo">Débito: <b class="rz-debito" id="rz-tot-deb">0,00</b></span>
        <span class="rz-resumo">Crédito: <b class="rz-credito" id="rz-tot-cre">0,00</b></span>
        <span class="rz-resumo">Saldo: <b id="rz-tot-saldo">0,00</b></span>
      </div>
    </div>

    {{!-- ====== GRADE DE LANÇAMENTOS ====== --}}
    <div class="rz-grade">
      <div class="rz-grade-head">
        <div class="rz-center">CHAVE</div>
        <div class="rz-center">DATA</div>
        <div class="rz-center">C/PART.</div>
        <div>CONTA</div>
        <div>HISTÓRICO</div>
        <div class="rz-right">DÉBITO</div>
        <div class="rz-right">CRÉDITO</div>
        <div class="rz-right">SALDO</div>
      </div>
      <div id="rz-grade-body">
        <div class="rz-empty">Selecione uma conta para ver os lançamentos.</div>
      </div>
    </div>

  </main>
</div>


{{!-- ====== POPUP DA CONTRAPARTIDA ======
      Aparece ao lado do código clicado. Mostra de que conta se trata sem
      trocar o razão que está na tela — a consulta em andamento não se perde. --}}
<div id="cp-pop" class="rz-cp-pop" hidden>
  <div class="rz-cp-cod" id="cp-cod"></div>
  <div class="rz-cp-nome" id="cp-nome">—</div>
  <div class="rz-cp-acoes">
    <button class="rz-btn" id="cp-abrir">Abrir esta conta</button>
    <button class="rz-btn-claro" id="cp-fechar">Fechar</button>
  </div>
</div>


{{!-- ====== MODAL DA BOLETA ====== --}}
<div id="bol-modal" class="rz-modal" hidden>
  <div class="rz-modal-card">
    <header>
      <h3 id="bol-titulo">Boleta</h3>
      <button class="rz-modal-close" id="bol-close">×</button>
    </header>
    <div class="rz-modal-body" id="bol-body"></div>
    <footer>
      <button class="rz-btn" id="bol-fechar">Fechar</button>
    </footer>
  </div>
</div>


<style>
  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');

  /* ====== ZERAR ESPAÇOS ====== */
  html, body { margin: 0; padding: 0; height: 100%; }
  body { font-family: system-ui, -apple-system, sans-serif; }

  /* ====== LAYOUT GLOBAL ====== */
  .contab-app {
    display: flex;
    min-height: 100vh;
    background: #fff;
  }

  /* ====== SIDEBAR FINA ====== */
  .cb-side {
    width: 50px;
    background: #1e2a3a;
    display: flex; flex-direction: column;
    padding: 12px 0; gap: 4px;
    flex-shrink: 0;
  }
  .cb-side-item {
    width: 38px; height: 38px;
    margin: 0 6px;
    display: flex; align-items: center; justify-content: center;
    color: #a8bdd0; cursor: pointer; border-radius: 6px;
    text-decoration: none;
    transition: all 0.12s;
  }
  .cb-side-item:hover { background: rgba(255,255,255,0.07); color: #fff; }
  .cb-side-item.active {
    background: rgba(77,171,247,0.15);
    color: #4dabf7;
    border-left: 3px solid #4dabf7;
    margin-left: 3px;
  }
  .cb-side-item i { font-size: 20px; }

  /* ====== SUBMENU ====== */
  .cb-submenu {
    width: 170px;
    background: #f8f9fa;
    border-right: 1px solid #dee2e6;
    flex-shrink: 0;
    padding: 14px 0;
  }
  .cb-submenu-title {
    font-size: 10px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.07em;
    color: #868e96; padding: 0 14px 8px;
  }
  .cb-sub-item {
    display: block; padding: 8px 14px;
    color: #495057; font-size: 12px;
    text-decoration: none; cursor: pointer;
    border-left: 3px solid transparent;
    transition: all 0.12s;
  }
  .cb-sub-item:hover { background: #e9ecef; color: #212529; }
  .cb-sub-item.active {
    background: #e7f5ff;
    color: #1971c2;
    font-weight: 500;
    border-left-color: #1971c2;
  }

  /* ====== CONTEÚDO ====== */
  .cb-content {
    flex: 1;
    min-width: 0;
    display: flex; flex-direction: column;
  }

  /* ====== PÁGINA RAZÃO ====== */
  .rz-page { background: #fff; }

  /* GRUPOS */
  .rz-grupos {
    display: flex; gap: 12px; padding: 10px 16px; align-items: center;
    border-bottom: 1px solid #e5e7eb; background: #fff;
  }
  /* A linha inteira é dividida em 5 partes iguais: as 4 abas e o período.
     Por isso .rz-tabs vale 4 e .rz-periodo-box vale 1. */
  .rz-tabs { display: flex; gap: 6px; flex: 4; }
  .rz-tab {
    flex: 1;
    padding: 7px 14px; font-size: 13px; font-weight: 600;
    border: 1px solid #d1d5db; border-radius: 6px; background: #fff;
    color: #374151; cursor: pointer;
    font-family: inherit;
  }
  .rz-tab:hover { background: #f3f4f6; }
  .rz-tab.active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }

  /* COMBOS */
  .rz-combos {
    display: flex; gap: 12px; padding: 10px 16px; align-items: center;
    background: #fafafa; border-bottom: 1px solid #e5e7eb;
  }

  .rz-combo {
    position: relative; display: flex; align-items: center; gap: 8px;
    border: 1px solid #d1d5db; border-radius: 6px; padding: 5px 10px;
    background: #fff; font-size: 13px; cursor: pointer; min-width: 240px;
    user-select: none; height: 32px;
  }
  .rz-combo:hover { border-color: #9ca3af; }
  .rz-combo-label { color: #6b7280; font-size: 10px; letter-spacing: 0.5px; }
  .rz-combo-value { color: #111; font-weight: 500; font-family: ui-monospace, monospace; flex: 1; }
  .rz-chev { margin-left: 4px; color: #6b7280; font-style: normal; }

  .rz-search {
    position: relative; display: flex; align-items: center; gap: 5px;
    border: 1px solid #d1d5db; border-radius: 6px; padding: 3px 8px;
    background: #fff; flex: 1; height: 28px;
  }

  /* PERÍODO (5ª parte da primeira linha) */
  .rz-periodo-box {
    flex: 1; display: flex; align-items: center; gap: 6px;
    border: 1px solid #d1d5db; border-radius: 6px;
    padding: 3px 8px; background: #fff; height: 28px;
  }
  .rz-periodo-box label {
    display: flex; align-items: center; gap: 3px;
    font-size: 12px; color: #374151; white-space: nowrap;
  }
  .rz-periodo-box input[type=date] {
    border: 0; outline: 0; background: transparent;
    font-size: 12px; font-family: inherit; color: #111;
    padding: 0; width: 100px;
  }
  .rz-search-icon { font-size: 11px; opacity: .5; }
  .rz-search input {
    border: 0; outline: 0; flex: 1; background: transparent;
    font-size: 12px; padding: 0; height: 18px;
    font-family: inherit;
  }

  /* O atributo hidden vale display:none, mas qualquer regra de classe com
     display: flex ganha dele por especificidade — e o elemento aparece mesmo
     "escondido". Estas duas linhas devolvem a palavra final ao hidden. */
  .rz-menu-drop[hidden],
  .rz-dropdown[hidden] { display: none !important; }

  /* POPUP DA CONTRAPARTIDA */
  .rz-cp-pop {
    position: absolute; z-index: 80; min-width: 250px;
    background: #fff; border: 1px solid #d1d5db; border-radius: 8px;
    padding: 12px 14px; box-shadow: 0 10px 30px rgba(0,0,0,.16);
  }
  .rz-cp-pop[hidden] { display: none !important; }
  .rz-cp-cod {
    font-family: ui-monospace, monospace; font-size: 14px;
    font-weight: 600; color: #1d4ed8;
  }
  .rz-cp-nome { font-size: 13px; color: #111; margin: 3px 0 10px; }
  .rz-cp-acoes { display: flex; gap: 8px; }
  .rz-btn-claro {
    padding: 5px 12px; border: 1px solid #d1d5db; border-radius: 6px;
    background: #fff; color: #374151; font-size: 12px;
    font-family: inherit; cursor: pointer;
  }
  .rz-btn-claro:hover { background: #f3f4f6; }

  /* DROPDOWN */
  .rz-dropdown {
    position: absolute; top: calc(100% + 2px); left: 0; right: 0; z-index: 50;
    background: #fff; border: 1px solid #d1d5db; border-radius: 6px;
    max-height: 320px; overflow-y: auto;
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    min-width: 280px;
  }
  .rz-dropdown .rz-opt {
    padding: 7px 10px; font-size: 13px; font-family: ui-monospace, monospace;
    cursor: pointer; border-bottom: 1px solid #f3f4f6;
  }
  .rz-dropdown .rz-opt:hover { background: #eff6ff; }
  .rz-dropdown .rz-opt.selected { background: #1d4ed8; color: #fff; }
  .rz-dropdown .rz-empty-opt { padding: 12px; text-align: center; color: #9ca3af; font-size: 11px; }

  /* BARRA DE AÇÕES + TOTAIS */
  .rz-totais {
    position: relative; display: flex; align-items: center;
    padding: 8px 16px; font-size: 13px; background: #fff;
    border-bottom: 1px solid #e5e7eb; gap: 18px;
  }
  /* Empurra período e totais para a direita, deixando o menu na esquerda. */
  .rz-direita {
    margin-left: auto; display: flex; align-items: center; gap: 18px;
  }

  /* MENU DE AÇÕES */
  .rz-menu { display: flex; align-items: center; gap: 4px; }
  .rz-menu-item {
    position: relative; display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: 5px; border: 0; background: transparent;
    font-size: 13px; font-family: inherit; color: #1f2937;
    cursor: pointer; text-decoration: none; white-space: nowrap;
  }
  .rz-menu-item:hover { background: #f3f4f6; color: #111; }
  .rz-menu-item.aberto { background: #eef2ff; color: #1d4ed8; }
  /* Sem conta escolhida no razão não há de onde tirar a perna única da
     boleta, então o item fica visível mas inerte. */
  .rz-menu-item.desativado { color: #9ca3af; cursor: not-allowed; }
  .rz-menu-item.desativado:hover { background: transparent; }
  .rz-menu-drop {
    position: absolute; top: 100%; left: 0; margin-top: 4px; z-index: 70;
    background: #fff; border: 1px solid #d1d5db; border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,.12); min-width: 140px;
    padding: 4px; display: flex; flex-direction: column;
  }
  .rz-menu-opt {
    display: block; text-decoration: none;
    text-align: left; padding: 6px 10px; border: 0; border-radius: 4px;
    background: transparent; font-size: 13px; font-family: inherit;
    color: #1f2937; cursor: pointer;
  }
  .rz-menu-opt:hover { background: #f3f4f6; }
  .rz-resumo { color: #374151; }
  .rz-resumo b { color: #111; }
  .rz-debito { color: #15803d !important; }
  .rz-credito { color: #b91c1c !important; }

  /* GRADE */
  .rz-grade { background: #fff; }

  /* A chave da boleta tem 12 a 13 dígitos em fonte monoespaçada: nos 70px de
     antes ela transbordava por cima da data. As colunas de valor também
     subiram, porque "1.234.567,89" não cabia em 100px.
     As larguras ficam num lugar só, na variável, para cabeçalho e linhas não
     saírem de sincronia. */
  .rz-grade { background: #fff; --rz-cols: 130px 90px 125px 190px 1fr 115px 115px 115px; }
  .rz-grade-head {
    display: grid; grid-template-columns: var(--rz-cols);
    background: #1d4ed8; color: #fff; font-size: 11px;
    padding: 7px 16px; gap: 10px; font-weight: 500;
  }
  .rz-row {
    display: grid; grid-template-columns: var(--rz-cols);
    padding: 9px 16px; gap: 10px; font-size: 13px; color: #111;
    font-family: ui-monospace, monospace; border-bottom: 1px solid #f3f4f6;
    align-items: center;
  }
  /* Chave, data e contrapartida centralizadas; histórico à esquerda;
     valores à direita. */
  .rz-row > div:nth-child(1),
  .rz-row > div:nth-child(2),
  .rz-row > div:nth-child(3) { text-align: center; }
  /* Nome da contrapartida e histórico longos cortam com reticências, em vez
     de empurrar as colunas de valor para fora da tela. */
  .rz-row .rz-hist,
  .rz-row .rz-cpart-nome {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .rz-row .rz-cpart-nome { font-family: system-ui, sans-serif; color: #374151; }
  .rz-row:hover { background: #fafafa; }
  .rz-row .rz-chave-link,
  .rz-row .rz-cpart-link {
    color: #1d4ed8; text-decoration: underline; cursor: pointer;
  }
  .rz-row .rz-chave-link:hover,
  .rz-row .rz-cpart-link:hover { color: #1e40af; }
  .rz-row .rz-hist { font-family: system-ui, sans-serif; }
  .rz-right  { text-align: right; }
  .rz-center { text-align: center; }
  .rz-row .rz-deb { color: #15803d; }
  .rz-row .rz-cre { color: #b91c1c; }
  .rz-row .rz-saldo-neg { color: #b91c1c; }
  .rz-row .rz-saldo-pos { color: #15803d; }
  .rz-row .rz-dash { color: #d1d5db; text-align: right; }

  .rz-empty {
    padding: 60px 16px; text-align: center; color: #9ca3af; font-size: 12px;
  }

  /* BOTÃO */
  .rz-btn {
    padding: 5px 14px; background: #1d4ed8; color: #fff;
    border: 0; border-radius: 6px; cursor: pointer; font-size: 11px;
    font-family: inherit;
  }
  .rz-btn:hover { background: #1e40af; }

  /* MODAL */
  .rz-modal {
    position: fixed; inset: 0; background: rgba(0,0,0,.45);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
  }
  .rz-modal[hidden] { display: none; }
  .rz-modal-card {
    background: #fff; border-radius: 12px; width: 720px; max-width: 92vw;
    max-height: 90vh; overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,.25);
  }
  .rz-modal-card header {
    background: #1d4ed8; color: #fff; padding: 12px 18px;
    display: flex; justify-content: space-between; align-items: center;
    position: sticky; top: 0;
  }
  .rz-modal-card header h3 { margin: 0; font-size: 1.05rem; }
  .rz-modal-close {
    background: transparent; color: #fff; border: 0; font-size: 1.4rem;
    cursor: pointer; line-height: 1;
  }
  .rz-modal-body { padding: 16px; }
  .rz-modal-card footer {
    padding: 10px 16px; display: flex; justify-content: flex-end;
    border-top: 1px solid #eee;
  }

  /* Boleta */
  .bol-secao { margin-bottom: 16px; }
  .bol-secao h3 { font-size: 13px; margin: 0 0 6px; color: #1d4ed8; }
  .bol-tabela { width: 100%; border-collapse: collapse; font-size: 11px; }
  .bol-tabela th, .bol-tabela td {
    padding: 6px 8px; border-bottom: 1px solid #e5e7eb; text-align: left;
  }
  .bol-tabela th { background: #f3f4f6; font-size: 10px; color: #6b7280; }
  .bol-tabela .v { text-align: right; font-family: ui-monospace, monospace; }
  .bol-cod { font-family: ui-monospace, monospace; color: #1d4ed8; }
  .bol-total {
    text-align: right; font-weight: 600; color: #1d4ed8;
    margin-top: 8px; font-family: ui-monospace, monospace;
  }
</style>

<script src="/js/contab/contabil/lancamento.js"></script>
<script src="/js/contab/contabil/razao.js"></script>
